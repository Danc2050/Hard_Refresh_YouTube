{
    "manifest_version": 3,
    "name": "Tab Refresher (Regex + Schedule)",
    "version": "1.1.0",
    "description": "Reload (or redirect) tabs whose URL matches a regex on a daily schedule (e.g., midnight).",
    "permissions": ["tabs", "storage", "browsingData", "alarms", "offscreen"],
    "host_permissions": ["<all_urls>"],
    "options_ui": {
    "page": "options.html",
    "open_in_tab": true
    },
    "background": {
    "service_worker": "background.js", "type": "module"
    },
    "icons": {
    "16": "icons/icon_16.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
    },
    "action": {
    "default_popup": "popup.html", "default_title": "Tab Refresher"
    }
    }